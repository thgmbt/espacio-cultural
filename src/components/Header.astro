---
// src/components/Header.astro
---
<link rel="stylesheet" href="styles/global.css">
<header class="header">
  <div class="logo">
    <a href="/">Espacio Cultural</a>
  </div>
  <nav class="nav">
    <ul>
      <li><a href="/">Inicio</a></li>
      <li><a href="/talleres">Talleres</a></li>
      <li><a href="/nosotros">Nosotros</a></li>
    </ul>
  </nav>
</header>

<style>
    .header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 1rem 2rem;
    background-color: #2c3e50;
    color: #ffffff;
  }

  .logo a {
    font-size: 1.5rem;
    font-weight: bold;
    color: #ffffff;
    text-decoration: none;
  }

  .nav ul {
    display: flex;
    gap: 1.5rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .nav a {
    color: #ffffff;
    text-decoration: none;
    font-weight: 500;
    transition: color 0.3s ease;
  }

  .nav a:hover {
    color: #f39c12;
  }
</style>