---
interface Props {
    nombre: string;
    descripcion: string;
    imagen: string;
    enlace?: string;
}

const { nombre, descripcion, imagen, enlace = "/talleres" } = Astro.props;
---

<li class="tarjeta-taller">
    <article>
        <div class="imagen-contenedor">
            <img src={imagen} alt={nombre} loading="lazy" />
        </div>
        <div class="contenido">
            <h3>{nombre}</h3>
            <p>{descripcion}</p>
            <a href={enlace} class="btn-enlace">Ver taller en detalle</a>
        </div>
    </article>
</li>
