---
// Definición de las Props que recibe el componente
interface Props {
    nombre: string;
    descripcion: string;
    imagen: string;
    enlace?: string;
}

const { nombre, descripcion, imagen, enlace = "#" } = Astro.props;
---

<li class="tarjeta-taller">
    <article>
        <img src={imagen} alt={`Imagen del taller ${nombre}`} loading="lazy" />
        <div class="contenido">
            <h3>{nombre}</h3>
            <p>{descripcion}</p>
            <a href={enlace} class="btn-enlace">Ver más información</a>
        </div>
    </article>
</li>

<style>
    .tarjeta-taller {
        list-style: none;
        border: 1px solid #e2e8f0;
        border-radius: 12px;
        overflow: hidden;
        box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1);
        transition:
            transform 0.2s ease,
            box-shadow 0.2s ease;
        background-color: #ffffff;
    }

    .tarjeta-taller:hover {
        transform: translateY(-4px);
        box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.1);
    }

    article img {
        width: 100%;
        height: 200px;
        object-fit: cover;
    }

    .contenido {
        padding: 1.5rem;
    }

    h3 {
        margin-top: 0;
        margin-bottom: 0.5rem;
        color: #1a202c;
    }

    p {
        color: #4a5568;
        font-size: 0.95rem;
        line-height: 1.5;
        margin-bottom: 1.25rem;
    }

    .btn-enlace {
        display: inline-block;
        padding: 0.5rem 1rem;
        background-color: #2b6cb0;
        color: #ffffff;
        text-decoration: none;
        border-radius: 6px;
        font-weight: 600;
        font-size: 0.9rem;
        transition: background-color 0.2s ease;
    }

    .btn-enlace:hover {
        background-color: #2c5282;
    }
</style>
