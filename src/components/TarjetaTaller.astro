---
// Definición de las Props que recibe el componente
interface Props {
    nombre: string;
    descripcion: string;
    imagen: string;
    enlace?: string;
}

const { nombre, descripcion, imagen, enlace = "#" } = Astro.props;
---

<li class="tarjeta-taller">
    <article>
        <img src={imagen} alt={`Imagen del taller ${nombre}`} loading="lazy" />
        <div class="contenido">
            <h3>{nombre}</h3>
            <p>{descripcion}</p>
            <a href={enlace} class="btn-enlace">Ver más información</a>
        </div>
    </article>
</li>
