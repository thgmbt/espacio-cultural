// src/components/Footer.astro
const currentYear = new Date().getFullYear();
---

<footer class="footer">
  <div class="footer-content">
    <p class="site-title">Espacio Cultural</p>
    <p class="copyright">este proyecto fue hecho por Fernando Ibarra y Cristhian Urdaneta</p>
  </div>
</footer>

<style>
  .footer {
    background-color: #2c3e50;
    color: #ffffff;
    text-align: center;
    padding: 1.5rem 2rem;
    margin-top: auto;
  }

  .footer-content {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    align-items: center;
  }

  .site-title {
    font-weight: bold;
    font-size: 1.1rem;
    margin: 0;
  }

  .copyright {
    font-size: 0.9rem;
    color: #bdc3c7;
    margin: 0;
  }
</style>