---
import Layout from "../layouts/layout.astro";
import TarjetaTalleres from "../components/TarjetaTaller.astro";

interface Taller {
	nombre: string;
	imagen: string;
}

const talleresDestacados: Taller[] = [
	{
		nombre: "Fotografía",
		imagen: "https://images.unsplash.com/photo-1554048612-b6a482bc67e5?q=80&w=600&auto=format&fit=crop",
	},
	{
		nombre: "Cerámica",
		imagen: "https://images.unsplash.com/photo-1565193566173-7a0ee3dbe261?q=80&w=600&auto=format&fit=crop",
	},
	{
		nombre: "Escritura creativa",
		imagen: "https://images.unsplash.com/photo-1455390582262-044cdead277a?q=80&w=600&auto=format&fit=crop",
	},
];
---

<Layout titulo="Inicio">
	<header class="hero">
		<h1>Bienvenidos a nuestro Espacio Cultural</h1>
		<p>Un espacio para aprender, crear y compartir en comunidad.</p>
	</header>

	<div class="contenedor">
		<section>
			<h2>Talleres Destacados</h2>

			<ul class="lista-talleres">
				{
					talleresDestacados.map((taller) => (
						<TarjetaTalleres
							nombre={taller.nombre}
							imagen={taller.imagen}
						/>
					))
				}
			</ul>

			<div class="mensaje-pie">
				<p>Visita la página de talleres para más detalle.</p>
			</div>
		</section>
	</div>
</Layout>

<style>
	.hero {
		background-color: #1e293b;
		color: #ffffff;
		text-align: center;
		padding: 3.5rem 1rem;
	}

	.contenedor {
		max-width: 1000px;
		margin: 3rem auto;
		padding: 0 1.5rem;
	}

	h2 {
		font-size: 1.8rem;
		text-align: center;
		margin-bottom: 2rem;
	}

	.lista-talleres {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
		gap: 2rem;
		padding: 0;
		margin: 0;
	}

	.mensaje-pie {
		text-align: center;
		margin-top: 2.5rem;
		font-size: 1.1rem;
		font-weight: 500;
		color: #475569;
	}
</style>
