---
import TarjetaTalleres from "../components/TarjetaTaller.astro";

interface Taller {
    nombre: string;
    descripcion: string;
    imagen: string;
}

// Lista con los 4 talleres requeridos
const todosLosTalleres: Taller[] = [
    {
        nombre: "Fotografía",
        descripcion:
            "Introducción a la composición y técnicas de fotografía digital.",
        imagen: "https://images.unsplash.com/photo-1554048612-b6a482bc67e5?q=80&w=600&auto=format&fit=crop",
    },
    {
        nombre: "Cerámica",
        descripcion:
            "Creación de objetos utilizando técnicas básicas de modelado.",
        imagen: "https://images.unsplash.com/photo-1565193566173-7a0ee3dbe261?q=80&w=600&auto=format&fit=crop",
    },
    {
        nombre: "Escritura creativa",
        descripcion: "Exploración de relatos breves y ejercicios de escritura.",
        imagen: "https://images.unsplash.com/photo-1455390582262-044cdead277a?q=80&w=600&auto=format&fit=crop",
    },
    {
        nombre: "Ilustración",
        descripcion:
            "Desarrollo de habilidades de dibujo e ilustración digital.",
        imagen: "https://images.unsplash.com/photo-1513364776144-60967b0f800f?q=80&w=600&auto=format&fit=crop",
    },
];
---

<html lang="es">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <title>Espacio Cultural | Todos los Talleres</title>
        <style>
            body {
                font-family:
                    system-ui,
                    -apple-system,
                    sans-serif;
                margin: 0;
                padding: 0;
                background-color: #f8fafc;
                color: #0f172a;
            }

            .encabezado-pagina {
                background-color: #2563eb;
                color: #ffffff;
                text-align: center;
                padding: 3rem 1rem;
            }

            .contenedor {
                max-width: 900px;
                margin: 3rem auto;
                padding: 0 1.5rem;
            }

            .lista-talleres {
                display: grid !important;
                /* Fuerza exactamente 2 columnas iguales */
                grid-template-columns: 1fr 1fr !important;
                gap: 2rem !important;
                padding: 0 !important;
                margin: 0 !important;
            }
        </style>
    </head>
    <body>
        <header class="encabezado-pagina">
            <h1>Nuestros Talleres</h1>
            <p>
                Conoce la oferta completa de talleres disponibles en nuestro
                espacio cultural.
            </p>
        </header>

        <main class="contenedor">
            <ul class="lista-talleres">
                {
                    todosLosTalleres.map((taller) => (
                        <TarjetaTalleres
                            nombre={taller.nombre}
                            descripcion={taller.descripcion}
                            imagen={taller.imagen}
                            mostrarBoton={false}
                        />
                    ))
                }
            </ul>
        </main>
    </body>
</html>

<style>
    body {
        font-family:
            system-ui,
            -apple-system,
            sans-serif;
        margin: 0;
        padding: 0;
        background-color: #f8fafc;
        color: #0f172a;
    }

    .encabezado-pagina {
        background-color: #2563eb;
        color: #ffffff;
        text-align: center;
        padding: 3rem 1rem;
    }

    .encabezado-pagina h1 {
        margin: 0 0 0.5rem 0;
        font-size: 2.5rem;
    }

    .contenedor {
        max-width: 1100px;
        margin: 3rem auto;
        padding: 0 1.5rem;
    }

    .lista-talleres {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
        gap: 2rem;
        padding: 0;
        margin: 0;
    }
</style>
